# Default: no accounts, credentials, API calls, or payments.
APP_MODE=demo
VITE_APP_MODE=demo
HOST=127.0.0.1
PORT=8080

# Optional integration mode. Configure a NEW development Firebase project.
# Review docs/LIVE_SETUP.md before changing either mode to live.
FIREBASE_PROJECT_ID=replace-me
FIREBASE_STORAGE_BUCKET=replace-me
APP_ORIGIN=http://localhost:8080
# Required in integration mode: Firebase UIDs of at most 20 development testers.
# Test Stripe credits do NOT pay for Gemini usage. Never allow arbitrary signups.
LIVE_ALLOWED_UIDS=replace-me
# Prefer workload identity/Application Default Credentials. Never commit a key file.
GEMINI_API_KEY=replace-me
# Explicitly choose models available to your own project; no silent fallback.
GEMINI_PARSE_MODEL=replace-me
GEMINI_IMAGE_MODEL=replace-me

# Firebase web config is public config, not an Admin credential.
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=replace-me
VITE_FIREBASE_PROJECT_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me

# Only test-mode checkout is implemented. Never insert a live Stripe key.
ENABLE_TEST_PAYMENTS=false
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
