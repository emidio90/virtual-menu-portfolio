{
  "name": "virtual-menu-portfolio",
  "version": "2.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "A food-image studio with an isolated offline demo and secure server-side integration adapters.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:rules": "firebase emulators:exec --project demo-virtual-menu --only firestore,storage 'node --test tests/emulator/*.test.js'",
    "scan": "node scripts/scan.mjs",
    "check": "npm run build && npm test && npm run scan",
    "reconcile": "node --env-file-if-exists=.env scripts/reconcile-job.mjs",
    "build:demo": "node scripts/build-demo.mjs"
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "express": "5.3.0",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "23.0.0",
    "lucide-react": "1.55.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "firebase-tools": "15.33.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
